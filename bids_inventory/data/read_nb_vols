#!/usr/bin/env python
"""Reads a nifti header and compute acquisition time.

Reads the beginning of a .nii or .nii.gz file from stdin
and prints the number of volumes and the repetition time.

https://neurostars.org/t/total-amount-of-fmri-hours-on-openneuro/27509/
"""
import gzip
import io
import sys

import nibabel as nb

GZIP_MAGIC = b"\x1f\x8b"
HEADER_CLASSES = {348: nb.Nifti1Header, 540: nb.Nifti2Header}

# Read the input only once:
# trying to decompress the stream directly consumes its first bytes
# even when it is not gzipped (.nii files),
# so the header would then be read from the wrong offset.
data = sys.stdin.buffer.read()

if data.startswith(GZIP_MAGIC):
    # only the beginning of the file is streamed: only decompress what is needed
    data = gzip.GzipFile(fileobj=io.BytesIO(data), mode="rb").read(max(HEADER_CLASSES))

# Only parse the fixed size header and not the header extensions
# that can be longer than what was streamed (and are not needed here).
for byteorder in ("little", "big"):
    sizeof_hdr = int.from_bytes(data[:4], byteorder)
    if sizeof_hdr in HEADER_CLASSES:
        break
else:
    sys.exit(f"Not a NIfTI-1 or NIfTI-2 header (sizeof_hdr={data[:4]!r})")

header = HEADER_CLASSES[sizeof_hdr].from_fileobj(io.BytesIO(data[:sizeof_hdr]))

repetition_time = float(header.get_zooms()[3])
# the repetition time is in the time unit of the header (seconds, milliseconds...)
# and some headers say seconds but have it in milliseconds: no TR is that long
time_unit = header.get_xyzt_units()[1]
repetition_time *= {"msec": 1e-3, "usec": 1e-6}.get(time_unit, 1)
if repetition_time > 100:
    repetition_time /= 1000

print(header["dim"][4], repetition_time)
